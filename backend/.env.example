# Uzun ve rastgele bir değer verin. Kök dizindeki .env dosyasında da aynısı olmalı.
DASHBOARD_API_KEY=change-me-to-a-long-random-value
DASHBOARD_CORS_ORIGINS=http://localhost:5173

# ESP32 ortam sensörü (boş bırakılırsa DASHBOARD_API_KEY kullanılır)
SENSOR_API_KEY=
TEMP_WARNING_C=27
TEMP_CRITICAL_C=32
TEMP_RAPID_RISE_C=2
HUMIDITY_LOW=20
HUMIDITY_HIGH=80

# Aynı olay için tekrar bildirim gönderilmeden önce beklenen süre
ALERT_COOLDOWN_MINUTES=10

# E-posta bildirimleri
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECEIVER_EMAIL=

# Telegram bildirimleri
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
